{
  "schemaVersion": 1,
  "id": "tvmod",
  "version": "${version}",
  "name": "TV Voice",
  "description": "Speaks text through Simple Voice Chat with the client command /tv",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tvmod.TvModClient"
    ],
    "voicechat": [
      "tvmod.TvVoicechatPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "voicechat_api": ">=2.6.0"
  }
}
